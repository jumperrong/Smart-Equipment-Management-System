# ========== 基础配置 ==========
# 对外端口（Windows 本机部署时直接访问 http://localhost:FRONTEND_PORT ）
FRONTEND_PORT=8080
BACKEND_PORT=8000

# JWT 密钥（生产环境请务必改成随机长字符串）
SECRET_KEY=please-change-this-to-a-very-long-random-string-at-least-32-char

# 数据库 SQLite 文件路径（容器内绝对路径，无需修改）
# SQLALCHEMY_DATABASE_URI=sqlite:////data/app.db
